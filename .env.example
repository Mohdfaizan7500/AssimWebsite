# ------------------------------------------------------------------
# aasim (frontend) environment — copy to .env and adjust
# ------------------------------------------------------------------

# Base URL of the backend API.
# Leave empty to use the relative "/api" path, which the Vite dev server
# proxies to the backend (see vite.config.js). Set a full URL in production,
# e.g. VITE_API_URL=https://your-api.example.com/api
VITE_API_URL=

# Dev proxy target for "/api" (used only during `npm run dev`)
VITE_API_PROXY=http://localhost:4000